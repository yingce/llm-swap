# Copy to .env and replace paths/URLs for the target host. This file contains
# references only; never put the agent token value here.
WORKER_IMAGE=llmswap-agent:frp-cu128
LLMSWAP_GATEWAY_URL=http://gateway-host:8080
WORKER_STATE_ROOT=/path/to/llmswap/workers
MODEL_ROOT=/path/to/llmswap/models
AGENT_TOKEN_FILE=/path/to/llmswap/secrets/agent-token
